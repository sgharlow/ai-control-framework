# AI Framework MCP Server Environment Configuration
# Copy this file to .env and configure as needed

# ============================================
# REQUIRED VARIABLES
# ============================================

# Path to the AI Framework templates directory
# This is where orchestration.md, code.md, patterns.md etc. are located
AI_FRAMEWORK_PATH=./ai-framework

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Logging level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Enable debug mode for verbose output
# Default: false
DEBUG=false

# Server timeout in milliseconds for framework state reading
# Default: 8000 (8 seconds)
STATE_READ_TIMEOUT=8000

# Evidence directory relative to project path
# Default: evidence
EVIDENCE_DIR=evidence

# Maximum age of evidence in minutes before considered stale
# Default: 120 (2 hours)
EVIDENCE_MAX_AGE=120

# Node environment
# Default: development
NODE_ENV=development
